# Copy to .env, then run `npm run keys:generate` to fill in the JWT keys.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Central database: users, tenants, memberships, sessions.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/central

# Tenant databases are created on this server with this role.
# Host and port default to the DATABASE_URL server.
# TENANT_DB_HOST=localhost
# TENANT_DB_PORT=5432
TENANT_DB_USER=postgres
TENANT_DB_PASSWORD=postgres

# Tenants are served at <slug>.BASE_DOMAIN. Browsers resolve *.localhost to this machine.
BASE_DOMAIN=localhost
# Also accept an X-Tenant header (curl, Postman, tests). Keep false in production.
TENANT_HEADER=true

# Ed25519 keys for access tokens, PEM with \n escapes. Generated by `npm run keys:generate`.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Connection pools: TENANT_POOLS_MAX x TENANT_POOL_MAX + central pool must stay under max_connections.
TENANT_POOLS_MAX=100
TENANT_POOL_MAX=5
MIGRATE_CONCURRENCY=4

# Behind a load balancer, set to the number of proxy hops (e.g. 1) or their addresses,
# so rate limits see the real client IP. Leave unset when clients connect directly:
# trusting X-Forwarded-For from anyone lets clients fake their IP.
# TRUST_PROXY=1

# Most tenants one user can own.
MAX_TENANTS_PER_USER=10

# Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false
