{
  "name": "saas-tenancy-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS API starter: one Postgres database per tenant, with Fastify, Drizzle and TypeScript.",
  "license": "MIT",
  "author": "Kipkoech Noah",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=4 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate:central": "drizzle-kit generate --config drizzle.central.config.ts",
    "db:generate:tenant": "drizzle-kit generate --config drizzle.tenant.config.ts",
    "migrate:central": "node --env-file-if-exists=.env scripts/migrate-central.ts",
    "migrate:tenants": "node --env-file-if-exists=.env scripts/migrate-tenants.ts",
    "tenant:create": "node --env-file-if-exists=.env scripts/tenant-create.ts",
    "tenant:retry": "node --env-file-if-exists=.env scripts/tenant-retry.ts",
    "dev:seed": "node --env-file-if-exists=.env scripts/dev-seed.ts",
    "keys:generate": "node scripts/keys-generate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.15",
    "lru-cache": "^11.5.3",
    "postgres": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
